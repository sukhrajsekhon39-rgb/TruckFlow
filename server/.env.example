# Copy to server/.env and fill in. Never commit the real .env.

# Required: long random string used to sign sign-in sessions.
# Generate one with:  openssl rand -hex 48
# Changing it signs everyone out.
JWT_SECRET=

MONGO_URI=mongodb://localhost:27017/truckflow
PORT=5000

# Set to "production" when the site is live (turns on secure cookies, hides error details).
NODE_ENV=development

# Public address of the site, used in password-reset emails.
APP_URL=http://localhost:3000

# Set to 1 when running behind a proxy or load balancer (Render, Heroku, Nginx).
TRUST_PROXY=

# Where uploaded load documents are stored (each company gets its own subfolder).
# Default: server/uploads/documents
DOCS_PATH=

# Email for password resets: either SMTP...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# ...or Gmail with an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
